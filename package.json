{
  "name": "smallapps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Small, dependency-free apps. First: a planning tool for agentic workflows grounded in published standards.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-plan": "./bin/plan.js"
  },
  "scripts": {
    "plan": "node bin/plan.js",
    "test": "node --test",
    "serve": "node scripts/serve.js",
    "localhost": "node scripts/localhost-server.js",
    "docs": "node scripts/gen-docs.js",
    "check": "node --test && node scripts/lint-refs.js && node scripts/gen-docs.js --check",
    "flow": "node scripts/flow-render.js",
    "flow:api": "node scripts/flow-api-server.js",
    "flow:endpoints": "node scripts/flow-endpoints.js"
  },
  "files": [
    "src",
    "bin",
    "apps"
  ]
}
